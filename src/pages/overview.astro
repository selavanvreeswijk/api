---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Overview – SudokuTime">

  <div class="overview">
    <div class="header">
      <h2>Your sessions</h2>
      <a href="/" class="btn-new">+ New game</a>
    </div>

    <!-- Statistieken -->
    <div class="stats">
      <div class="stat">
        <span class="stat-label">Played</span>
        <span class="stat-number" id="stat-played">0</span>
      </div>
      <div class="stat">
        <span class="stat-label">Solved</span>
        <span class="stat-number" id="stat-solved">0</span>
      </div>
      <div class="stat">
        <span class="stat-label">Jokes earned</span>
        <span class="stat-number" id="stat-jokes">0</span>
      </div>
    </div>

    <!-- Filterknoppen -->
    <div class="filters">
      <button class="filter active" data-filter="all">All</button>
      <button class="filter" data-filter="solved">Solved</button>
      <button class="filter" data-filter="unsolved">Not solved</button>
    </div>

    <!-- Sessieslijst -->
    <ul class="session-list" id="session-list"></ul>

    <p id="no-sessions" class="empty-text hidden">No sessions yet. 
    <a href="/">Play a game!</a></p>
  </div>

</MainLayout>

<script>
  // @ts-nocheck

  // ------------------------------------ MARK: Sessies lezen
  // Bron: https://developer.mozilla.org/en-US/docs/Web/API/Window/localStorage
  const sessions = JSON.parse(localStorage.getItem('sessions') || '[]');

  // ------------------------------------ MARK: Statistieken
  document.getElementById('stat-played').textContent = sessions.length;

  const solved = sessions.filter(s => {
    return s.solved;
  });
  document.getElementById('stat-solved').textContent = solved.length;

  const withJoke = sessions.filter(s => {
    return s.joke;
  });
  document.getElementById('stat-jokes').textContent = withJoke.length;

  // ------------------------------------ MARK: Sessies renderen
  function renderSessions(filter) {
    const list = document.getElementById('session-list');

    list.innerHTML = '';

    const filtered = sessions.filter(s => {
      if (filter === 'solved')   return s.solved;     // Alleen opgeloste
      if (filter === 'unsolved') return !s.solved;    // Alleen niet opgeloste
      return true;                                    // Alles
    });

    if (filtered.length === 0) {
      document.getElementById('no-sessions').classList.remove('hidden');
      return;
    }

    document.getElementById('no-sessions').classList.add('hidden');

    // Nieuwste sessies bovenaan
    // Bron: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/reverse
    filtered.slice().reverse().forEach(session => {
      const date = new Date(session.date);
      const hour = date.getHours();
      const icon = (hour >= 6 && hour < 18) ? '☀️' : '🌙';

      // Datum formatteren: vandaag of dag + datum
      // Bron: https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Date/toLocaleDateString
      const isToday = new Date().toDateString() === date.toDateString();
      const timeStr = date.toLocaleTimeString('en', { 
        hour: '2-digit', 
        minute: '2-digit' 
      });

      const dateStr = isToday
        ? `Today, ${timeStr}`
        : `${date.toLocaleDateString('en', { weekday: 'short', day: 'numeric', month: 'short' })}, ${timeStr}`;

      const minutes = session.endTime
        ? Math.round((session.endTime - session.startTime) / 1000 / 60)
        : null;

      // Lijstitem aanmaken en vullen met sessiedata
      // Bron: https://developer.mozilla.org/en-US/docs/Web/API/Document/createElement
      const li = document.createElement('li');
      li.className = 'session-item';
      li.innerHTML = `
        <div class="session-left">
          <span class="session-icon">${icon}</span>
          <div>
            <div class="session-date">${dateStr}</div>
            <div class="session-sub">${session.solved ? `Solved in ${minutes} min` : 'Not solved'}</div>
            ${session.joke ? `<div class="session-joke">"${session.joke}"</div>` : ''}
          </div>
        </div>
        <span class="badge badge-${session.difficulty || 'medium'}">${session.difficulty || 'medium'}</span>
      `;
      list.appendChild(li);
    });
  }

  // ------------------------------------ MARK: Filterknoppen
  document.querySelectorAll('.filter').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter').forEach(b => {
        b.classList.remove('active');
      });
      btn.classList.add('active');
      renderSessions(btn.dataset.filter);
    });
  });

  // Eerste render bij het laden van de pagina
  if (sessions.length === 0) {
    document.getElementById('no-sessions').classList.remove('hidden');
  } else {
    renderSessions('all');
  }
</script>

<style is:global>
  .overview{
    width: 100%;
    max-width: 480px;
  }

  .header{
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5em;
  }

  .header h2{
    color: var(--pink);
    font-size: 1.2em;
  }

  .btn-new{
    background: transparent;
    color: var(--pink);
    border: 1.5px solid var(--pink);
    border-radius: 50px;
    font-size: 0.9em;
    text-decoration: none;
    cursor: pointer;
    font-weight: bold;
    transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease;

    padding: 0.4em 1em;
  }

  .btn-new:hover{
    background: var(--pink);
    color: var(--dark);
    transform: scale(1.04);
  }

  /* Statistieken */
  .stats{
    display: flex;
    gap: 1em;
    margin-bottom: 1.5em;
  }

  .stat{
    display: flex;
    flex-direction: column;

    background: var(--card);
    border-radius: 10px;
    flex: 1;
    border: 1px solid var(--border);

    gap: 0.3em;
    padding: 1em 1.5em;
  }

  .stat-label{
    color: var(--grey);
    font-size: 0.8em;
  }

  .stat-number{
    color: var(--pink);
    font-size: 1.8em;
    font-weight: bold;
  }

  /* Filterknoppen */
  .filters{
    display: flex;

    gap: 0.5em;
    margin-bottom: 1em;
  }

  .filter{
    background: none;
    border: 1.5px solid var(--border-light);
    color: var(--mid-grey);
    font-size: 0.85em;
    cursor: pointer;
    border-radius: 50px;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;

    padding: 0.3em 0.9em;
  }

  .filter.active{
    color: var(--dark);
    background: var(--pink);
    border-color: var(--pink);
    font-weight: bold;
  }

  .filter:hover:not(.active){
    border-color: var(--grey);
    color: var(--light-grey);
  }

  /* Sessielijst */
  .session-list{
    display: flex;
    flex-direction: column;

    list-style: none;

    gap: 0.5em;
    padding: 0;
    margin: 0;
  }

  .session-item{
    display: flex;
    justify-content: space-between;
    align-items: flex-start;

    background: var(--card);
    border-radius: 10px;
    border: 1px solid var(--border);
    transition: background 0.15s ease;

    padding: 1em;
  }

  .session-item:hover{
    background: var(--card-hover);
  }

  .session-left{
    display: flex;
    align-items: flex-start;

    gap: 0.75em;
  }

  .session-icon{
    font-size: 1.2em;

    margin-top: 2px;
  }

  .session-date{
    color: var(--pink);
    font-size: 0.95em;
    font-weight: bold;
  }

  .session-sub{
    color: var(--grey);
    font-size: 0.8em;

    margin-top: 0.2em;
  }

  .session-joke{
    color: var(--light-grey);
    font-style: italic;
    line-height: 1.4;
    font-size: 0.78em;
    max-width: 300px;

    margin-top: 0.3em;
  }

  /* Moeilijkheidsbadges */
  .badge{
    font-size: 0.75em;
    font-weight: bold;
    border-radius: 20px;
    white-space: nowrap;

    padding: 0.2em 0.7em;
  }

  .badge-easy{
    background: var(--badge-green);
    color: var(--dark);
  }

  .badge-medium{
    background: var(--badge-yellow);
    color: var(--dark);
  }

  .badge-hard{
    background: var(--pink);
    color: var(--dark);
  }

  .empty-text{
    color: var(--grey);
    text-align: center;
    font-size: 0.95em;

    margin-top: 2em;
  }

  .empty-text a{
    color: var(--pink);
  }

  .hidden{
    display: none;
  }
</style>
