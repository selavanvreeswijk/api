---
const { title } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="icon" href="../../public/favicon2.png" />

  </head>
  <body>
    <header>
      <h1>Sudoku</h1>
      
      <nav>
        <a href="/overview">Overview</a>
        <a href="/">Play</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

  </body>
</html>

<style>
  @font-face{ 
      font-family:'Sudoku';
      src: url('../../fonts/sudoku.ttf') format('TrueType');
  }

  h1 {
    font-family: 'Sudoku', sans-serif;
    color: #f7d1dc;
  }

  header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  nav a {
    color: #999;
    text-decoration: none;
    font-size: 0.95rem;
  }

  nav a:hover { color: #f7d1dc; }

  body {
    background-color: #2e2e2c;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem;
    box-sizing: border-box;
  }

  main {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
</style>