---
const { title } = Astro.props;
---

<!-- ------------------------------------ MARK: Basis Layout 
-->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon2.png" />
    <!-- Bron confetti: Claude. Mijn prompt: hoe zou ik confetti kunnen inladen die verschijnt wanneer de gebruiker iets triggered -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>
  </head>
  <body>
    <header>
      <a href="/" class="logo"><h1>Sudoku</h1></a>
      <nav>
        <a href="/overview">Overview</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  /* ------------------------------------ MARK: Basale opmaak
  */

  :root{
    /* Achtergronden */
    --dark:        #2e2e2c;
    --card:        #3e3e3c;
    --card-hover:  #474745;
    --popup-dark:  #1a1a1a;
    --cell-grey:   #f0eeea;
    --cell-white:  #ffffff;
    --cell-purple: #e8e2f8;

    /* Roze */
    --pink:       #f7d1dc;
    --hot-pink:   #f472b6;
    --pink-light: #f9a8d4;

    /* Teksten */
    --cream:      #f5f0e8;
    --grey:       #999;
    --mid-grey:   #777;
    --dark-grey:  #666;
    --light-grey: #aaa;
    --black:      #1a1a1a;

    /* Borders */
    --border:        #4a4a48;
    --border-light:  #3a3a38;
    --line-thick:    #444;
    --line-thin:     #ccc;
    --purple-border: #a78bfa;

    /* Feedback */
    --green-bg:   rgba(100, 200, 120, 0.25);
    --green-text: #1a6e35;
    --red-bg:     rgba(220, 80, 80, 0.2);
    --red-text:   #b91c1c;
    --drag-pink:  rgba(247, 209, 220, 0.4);

    /* Badges */
    --badge-green:  #c8f7c5;
    --badge-yellow: #f7f0c5;
  }

  @font-face{
    font-family: 'Sudoku';
    src: url('/fonts/sudoku.ttf') format('TrueType');
  }

  @font-face{
    font-family: 'DM Mono';
    src: url('/fonts/dmmono-regular.ttf') format('TrueType');
  }

  *{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body{
    background-color: var(--dark);
    font-family: 'DM Mono', sans-serif;
    color: var(--cream);
    min-height: 100vh;

    display: flex;
    flex-direction: column;
    align-items: center;

    padding: clamp(1em, 4vw, 2.5em) clamp(0.75em, 3vw, 2em);
  }

  .logo{
    text-decoration: none;
  }

  h1{
    font-family: 'Sudoku', sans-serif;
    color: var(--pink);
    font-size: clamp(1.4em, 5vw, 2em);
    letter-spacing: 0.05em;
  }

  header{
    display: flex;
    align-items: center;
    gap: clamp(1em, 3vw, 2em);

    margin-bottom: clamp(1.5em, 4vw, 2.5em);
    width: 100%;
    max-width: 480px;
  }

  nav{
    display: flex;
    gap: clamp(0.75em, 2vw, 1.25em);
    margin-left: auto;
  }

  nav a{
    color: var(--dark-grey);
    text-decoration: none;
    font-size: clamp(0.8em, 2.5vw, 0.9em);
    letter-spacing: 0.03em;

    transition: color 0.2s ease;
  }

  nav a:hover{
    color: var(--pink);
  }

  main{
    display: flex;
    flex-direction: column;
    align-items: center;

    width: 100%;
  }
</style>
